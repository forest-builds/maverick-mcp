root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space

[*.py]
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

[*.md]
# Markdown uses trailing double-space for a hard line break — don't strip it.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
